# EditorConfig：固化本项目的排版约定，避免不同编辑器改乱缩进、换行符与尾随空白。
# 见 https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Markdown 里行尾两个空格表示硬换行，不能裁掉；长段落由编辑器软换行显示，不限制行宽。
trim_trailing_whitespace = false
max_line_length = off
